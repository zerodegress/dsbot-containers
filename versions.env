# Pinned versions for this image, and the evidence behind each one.
#
# Every value here is what the build pins. `scripts/check-versions.sh` compares
# these against the registries and reports drift; it never edits this file.
#
# Tiers, so a reader never confuses an upstream guarantee with something we
# measured:
#   declared  the combination the package maintainer tested (its own docs)
#   measured  a combination that runs here, outside the upstream declaration
#   untested  known to exist, never run

# --- dsh and ds-bot ----------------------------------------------------------
# declared: ds-bot's own docs say "Tested with dsh 0.2.0-rc.2" and its harness
#   pins that version. measured: 0.2.1-rc.2 with ds-bot 0.1.7 runs here; the
#   upstream declaration does not cover it.
DSH_VERSION=0.2.1-rc.2
DS_BOT_VERSION=0.1.7

# --- bundled security pair ---------------------------------------------------
AUTH_GATE_VERSION=0.17.4
# The auth gate declares engines.dsh >=0.2.0-rc.1, which covers the pin above.
AUTHLESS_COMMIT=26fe680a078ba527f811291db4b527a505ad9bee
AUTHLESS_SHA256=809ef67b225173128b4720650c81e10439981e3eab53e9fe00a10d635ee2084f
# authless declares engines.dsh >=0.2.1-rc.2 <0.3.0, so the two move together.

# --- base image --------------------------------------------------------------
# Both Dockerfiles reference node:22.22-bookworm-slim. The tag is what humans
# read; the digest is what the build follows.
NODE_BASE_IMAGE=docker.io/library/node:22.22-bookworm-slim
# Multi-arch manifest list. Pin this in FROM: it stays valid on every
# architecture, while a per-arch digest would break a non-amd64 build.
NODE_BASE_DIGEST=sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752
# The amd64 entry of that list. Recorded so a rebuild can be compared against
# the exact filesystem that was reviewed; it is not what FROM takes.
NODE_AMD64_DIGEST=sha256:16d364eebf6b62da439dc993d9b80940c78b0ca38438452f011ab9a25c752644

# --- tools fetched by release tag -------------------------------------------
# These are pinned by version + sha256 inside tools/Dockerfile; the values are
# repeated here so drift detection can see them without parsing the Dockerfile.
JJ_VERSION=0.46.0
YQ_VERSION=4.54.1
